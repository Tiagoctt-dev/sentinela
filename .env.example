# Copie este arquivo para ".env" na raiz e preencha as chaves que tiver.
# A camada de IA roda os provedores configurados EM PARALELO — com as duas
# chaves preenchidas, cada achado recebe uma recomendação do Gemini E uma do
# Groq (duas "opiniões" independentes lado a lado). Com só uma, roda só essa.
# Sem nenhuma, o scanner ainda funciona — usa as recomendações estáticas.

GEMINI_API_KEY=
# Opcional: modelo a usar (padrão: gemini-flash-latest, com fallback)
GEMINI_MODEL=

# Pegue em https://console.groq.com/keys (conta grátis, tem free tier)
GROQ_API_KEY=
# Opcional: modelo a usar (padrão: openai/gpt-oss-120b, com fallback)
GROQ_MODEL=

# --- Acesso e operação (todos opcionais) ---
# Login: por padrão o Sentinela exige usuário/senha (o primeiro acesso cria o administrador).
# Para uso local sem login, descomente:
# SENTINELA_AUTH=off
# Chave que criptografa as credenciais de teste e assina as sessões. Se vazia, é gerada em
# backend/.secret_key na primeira execução. Em containers/produção, defina explicitamente:
# SENTINELA_SECRET_KEY=   (gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Endereços públicos usados nos links das integrações e no teste de SSRF (o alvo precisa alcançar PUBLIC_API_URL):
# PUBLIC_APP_URL=http://localhost:5173
# PUBLIC_API_URL=http://localhost:8000
# Desliga o agendador de scans:
# SENTINELA_SCHEDULER=off
